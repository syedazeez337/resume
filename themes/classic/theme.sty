%% theme.sty - Classic Theme (Corporate/Professional)
%% Goal: Elegant, traditional look (Finance, Enterprise)

\RequirePackage{charter} %% Excellent serif font included in TeX Live

%% Colors: Navy Blue & Dark Gray
\definecolor{primary}{HTML}{1A365D}      % Navy Blue
\definecolor{secondary}{HTML}{4A5568}    % Slate Gray
\definecolor{accent}{HTML}{2B6CB0}       % Professional Blue
\definecolor{text}{HTML}{2D3748}         % Dark Gray

%% Header: Name prominent, rule under header
\renewcommand{\name}[1]{
    {\Huge\bfseries\color{primary}#1}
}

\renewcommand{\tagline}[1]{
    {\large\itshape\color{secondary}#1}
}

%% Icons: Keep them, but subtle
\renewcommand{\email}[1]{\href{mailto:#1}{\faEnvelope\ #1}}
\renewcommand{\phone}[1]{\faPhone\ #1}
\renewcommand{\location}[1]{\faMapMarker*\ #1}
\renewcommand{\linkedin}[1]{\href{https://linkedin.com/in/#1}{\faLinkedin\ #1}}
\renewcommand{\github}[1]{\href{https://github.com/#1}{\faGithub\ #1}}

%% Sections: Bold, Blue, with rule
\titleformat{\section}{
    \Large\bfseries\color{primary}
}{}{0em}{}[\color{accent}\titlerule]
\titlespacing*{\section}{0pt}{14pt}{8pt}

%% Subsections
\titleformat{\subsection}{
    \large\bfseries\color{text}
}{}{0em}{}

%% Experience: Classic format
\renewcommand{\experience}[5]{
    \subsection[#1]{#1}
    \textbf{#2} \hfill \textit{#3} \\
    {\small\color{secondary}#4}
    \begin{itemize}[leftmargin=*, nosep, topsep=4pt]
        #5
    \end{itemize}
}