%% theme.sty - Minimal Theme (ATS Optimized)
%% Goal: Maximum machine readability, zero "fluff"

\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}

%% Colors: Strictly Black & White
\definecolor{primary}{HTML}{000000}
\definecolor{secondary}{HTML}{000000}
\definecolor{accent}{HTML}{000000}
\definecolor{text}{HTML}{000000}

%% Header: Simple centered text
\renewcommand{\name}[1]{
    {\LARGE\bfseries\MakeUppercase{#1}}
}

\renewcommand{\tagline}[1]{
    {\large #1}
}

%% Contact: Plain text, separators
\renewcommand{\contact}[1]{
    {\small #1}
}

%% Icons: Redefine to empty or text equivalents for ATS
\renewcommand{\email}[1]{#1}
\renewcommand{\phone}[1]{#1}
\renewcommand{\location}[1]{#1}
\renewcommand{\linkedin}[1]{linkedin.com/in/#1}
\renewcommand{\github}[1]{github.com/#1}
\renewcommand{\website}[1]{#1}

%% Sections: Uppercase, simple underline
\titleformat{\section}{
    \large\bfseries\uppercase
}{}{0em}{}[\hrule]
\titlespacing*{\section}{0pt}{12pt}{8pt}

%% Experience: Standard bold/italic structure
\renewcommand{\experience}[5]{
    \subsection[#1]{#1}
    \textbf{#2} \hfill #3 \
    \textit{#4}
    \begin{itemize}[leftmargin=*, nosep, topsep=2pt]
        #5
    \end{itemize}
}

%% Skills: Simple list
\renewcommand{\skillcategory}[2]{
    \textbf{#1:} #2 \\[2pt]
}