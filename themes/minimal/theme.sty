%% theme.sty - Minimal Theme
%% Clean grayscale design, ATS-optimized

%% Color palette - grayscale only for ATS compatibility
\definecolor{primary}{HTML}{000000}      % Pure black
\definecolor{secondary}{HTML}{4B5563}    % Medium gray
\definecolor{accent}{HTML}{374151}       % Dark gray
\definecolor{text}{HTML}{1F2937}         % Near black
\definecolor{lightgray}{HTML}{F9FAFB}    % Very light gray

%% Typography - standard fonts for ATS
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}

%% Section styling - clean and simple
\titleformat{\section}{
    \large\bfseries\color{primary}\scshape
}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{14pt}{8pt}

%% Disable colored links for ATS
\hypersetup{
    colorlinks=false,
    pdfborder={0 0 0}
}

%% Standard margins
\geometry{margin=0.75in}

%% Minimal header styling
\renewcommand{\name}[1]{
    {\LARGE\bfseries #1}
}

\renewcommand{\tagline}[1]{
    {\normalsize #1}
}

%% Plain contact info (no icons for ATS)
\renewcommand{\email}[1]{\href{mailto:#1}{#1}}
\renewcommand{\phone}[1]{#1}
\renewcommand{\location}[1]{#1}
\renewcommand{\linkedin}[1]{\href{https://linkedin.com/in/#1}{linkedin.com/in/#1}}
\renewcommand{\github}[1]{\href{https://github.com/#1}{github.com/#1}}
\renewcommand{\website}[1]{\href{https://#1}{#1}}

%% Simple skill formatting
\renewcommand{\skillcategory}[2]{
    \textbf{#1:} #2 \\[2pt]
}

%% Disable skill bars in minimal theme
\renewcommand{\skillbar}[2]{
    #1 \\[2pt]
}
