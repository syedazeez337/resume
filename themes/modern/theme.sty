%% theme.sty - Modern Theme (Tech/Startup)
%% Goal: Clean, airy, visual appeal

%% Font: Inter (modern sans-serif)
\RequirePackage[sfdefault]{inter}
\renewcommand{\familydefault}{\sfdefault}

%% Colors: Vibrancy
\definecolor{primary}{HTML}{2563EB}      % Bright Blue
\definecolor{secondary}{HTML}{64748B}    % Cool Gray
\definecolor{accent}{HTML}{0EA5E9}       % Sky Blue
\definecolor{text}{HTML}{0F172A}         % Rich Black

%% Header: Centered, clean
\renewcommand{\name}[1]{
    {\Huge\bfseries\color{primary}#1}
}

\renewcommand{\tagline}[1]{
    {\Large\color{secondary}#1}
}

%% Icons: Use FontAwesome5 colored icons
\renewcommand{\email}[1]{\href{mailto:#1}{\color{accent}\faEnvelope\ \color{text}#1}}
\renewcommand{\phone}[1]{\color{accent}\faPhone\ \color{text}#1}
\renewcommand{\location}[1]{\color{accent}\faMapMarker*\ \color{text}#1}
\renewcommand{\linkedin}[1]{\href{https://linkedin.com/in/#1}{\color{accent}\faLinkedin\ \color{text}#1}}
\renewcommand{\github}[1]{\href{https://github.com/#1}{\color{accent}\faGithub\ \color{text}#1}}

%% Sections: Modern look, no rule, just spacing and color
\titleformat{\section}{
    \Large\bfseries\color{primary}
}{}{0em}{}
\titlespacing*{\section}{0pt}{8pt}{4pt}

%% Experience: Slight indentation, bullet styling
\renewcommand{\experience}[5]{
    \subsection[#1]{#1}
    {\large\textbf{#2}} \hfill \color{primary}\textbf{#3} \\
    {\small\color{secondary}\faCalendar\ #4}
    \begin{itemize}[leftmargin=*, label=\textcolor{accent}{\faAngleRight}, nosep, topsep=6pt]
        #5
    \end{itemize}
}

%% OSS Project block: colored dates, accent angle-right bullets
\renewcommand{\ossproject}[4]{%
    \textbf{#1} \hfill \color{primary}\textbf{#3} \\
    {\small\color{secondary}#2}
    \begin{itemize}[leftmargin=*, label=\textcolor{accent}{\faAngleRight}, nosep, topsep=1pt]
        #4
    \end{itemize}
    \vspace{2pt}
}

%% OSS Single-line project: matching modern style
\renewcommand{\ossprojectsingle}[4]{%
    \textbf{#1} \hfill \color{primary}\textbf{#3} \\
    {\small\color{secondary}#2} \\[1pt]
    {\small #4}
    \vspace{2pt}
}

%% Skills: Tags style
\renewcommand{\skillcategory}[2]{
    \textbf{\color{primary}#1} \\
    {\color{secondary}#2} \\[6pt]
}
